// Whisper-tiny — Speech-to-text transcription.
// Architecture: 2×Conv1D encoder + 4 Encoder blocks + 4 Decoder blocks (autoregressive)
// d_model=384, n_heads=6, mlp_ratio=4, encoder_seq=1500, max_decode=40
// Weights: python3 download_weights.py (once). Profile: PYTHONPATH=../../src python3 -m einlang main.ein --profile-verbose

use std::ml::{layer_normalization, gelu};
use std::math::{exp, sqrt};
use std::io::load_npy;

// ====================== Encoder weights ======================
let enc_conv1_w = load_npy("weights/enc_conv1_w.npy") as [f32; 384, 80, 3];
let enc_conv1_b = load_npy("weights/enc_conv1_b.npy") as [f32; 384];
let enc_conv2_w = load_npy("weights/enc_conv2_w.npy") as [f32; 384, 384, 3];
let enc_conv2_b = load_npy("weights/enc_conv2_b.npy") as [f32; 384];
let enc_pos_emb = load_npy("weights/enc_pos_emb.npy") as [f32; 1500, 384];

let enc_blk_sa_ln_w = load_npy("weights/enc_blk_sa_ln_w.npy") as [f32; 4, 384];
let enc_blk_sa_ln_b = load_npy("weights/enc_blk_sa_ln_b.npy") as [f32; 4, 384];
let enc_blk_sa_q_w  = load_npy("weights/enc_blk_sa_q_w.npy")  as [f32; 4, 384, 384];
let enc_blk_sa_q_b  = load_npy("weights/enc_blk_sa_q_b.npy")  as [f32; 4, 384];
let enc_blk_sa_k_w  = load_npy("weights/enc_blk_sa_k_w.npy")  as [f32; 4, 384, 384];
let enc_blk_sa_v_w  = load_npy("weights/enc_blk_sa_v_w.npy")  as [f32; 4, 384, 384];
let enc_blk_sa_v_b  = load_npy("weights/enc_blk_sa_v_b.npy")  as [f32; 4, 384];
let enc_blk_sa_o_w  = load_npy("weights/enc_blk_sa_o_w.npy")  as [f32; 4, 384, 384];
let enc_blk_sa_o_b  = load_npy("weights/enc_blk_sa_o_b.npy")  as [f32; 4, 384];
let enc_blk_mlp_ln_w = load_npy("weights/enc_blk_mlp_ln_w.npy") as [f32; 4, 384];
let enc_blk_mlp_ln_b = load_npy("weights/enc_blk_mlp_ln_b.npy") as [f32; 4, 384];
let enc_blk_fc1_w = load_npy("weights/enc_blk_fc1_w.npy") as [f32; 4, 384, 1536];
let enc_blk_fc1_b = load_npy("weights/enc_blk_fc1_b.npy") as [f32; 4, 1536];
let enc_blk_fc2_w = load_npy("weights/enc_blk_fc2_w.npy") as [f32; 4, 1536, 384];
let enc_blk_fc2_b = load_npy("weights/enc_blk_fc2_b.npy") as [f32; 4, 384];

let enc_ln_w = load_npy("weights/enc_ln_w.npy") as [f32; 384];
let enc_ln_b = load_npy("weights/enc_ln_b.npy") as [f32; 384];

// ====================== Decoder weights ======================
let dec_tok_emb = load_npy("weights/dec_tok_emb.npy") as [f32; 51865, 384];
let dec_pos_emb = load_npy("weights/dec_pos_emb.npy") as [f32; 448, 384];

let dec_blk_sa_ln_w = load_npy("weights/dec_blk_sa_ln_w.npy") as [f32; 4, 384];
let dec_blk_sa_ln_b = load_npy("weights/dec_blk_sa_ln_b.npy") as [f32; 4, 384];
let dec_blk_sa_q_w  = load_npy("weights/dec_blk_sa_q_w.npy")  as [f32; 4, 384, 384];
let dec_blk_sa_q_b  = load_npy("weights/dec_blk_sa_q_b.npy")  as [f32; 4, 384];
let dec_blk_sa_k_w  = load_npy("weights/dec_blk_sa_k_w.npy")  as [f32; 4, 384, 384];
let dec_blk_sa_v_w  = load_npy("weights/dec_blk_sa_v_w.npy")  as [f32; 4, 384, 384];
let dec_blk_sa_v_b  = load_npy("weights/dec_blk_sa_v_b.npy")  as [f32; 4, 384];
let dec_blk_sa_o_w  = load_npy("weights/dec_blk_sa_o_w.npy")  as [f32; 4, 384, 384];
let dec_blk_sa_o_b  = load_npy("weights/dec_blk_sa_o_b.npy")  as [f32; 4, 384];

let dec_blk_ca_ln_w = load_npy("weights/dec_blk_ca_ln_w.npy") as [f32; 4, 384];
let dec_blk_ca_ln_b = load_npy("weights/dec_blk_ca_ln_b.npy") as [f32; 4, 384];
let dec_blk_ca_q_w  = load_npy("weights/dec_blk_ca_q_w.npy")  as [f32; 4, 384, 384];
let dec_blk_ca_q_b  = load_npy("weights/dec_blk_ca_q_b.npy")  as [f32; 4, 384];
let dec_blk_ca_k_w  = load_npy("weights/dec_blk_ca_k_w.npy")  as [f32; 4, 384, 384];
let dec_blk_ca_v_w  = load_npy("weights/dec_blk_ca_v_w.npy")  as [f32; 4, 384, 384];
let dec_blk_ca_v_b  = load_npy("weights/dec_blk_ca_v_b.npy")  as [f32; 4, 384];
let dec_blk_ca_o_w  = load_npy("weights/dec_blk_ca_o_w.npy")  as [f32; 4, 384, 384];
let dec_blk_ca_o_b  = load_npy("weights/dec_blk_ca_o_b.npy")  as [f32; 4, 384];

let dec_blk_mlp_ln_w = load_npy("weights/dec_blk_mlp_ln_w.npy") as [f32; 4, 384];
let dec_blk_mlp_ln_b = load_npy("weights/dec_blk_mlp_ln_b.npy") as [f32; 4, 384];
let dec_blk_fc1_w = load_npy("weights/dec_blk_fc1_w.npy") as [f32; 4, 384, 1536];
let dec_blk_fc1_b = load_npy("weights/dec_blk_fc1_b.npy") as [f32; 4, 1536];
let dec_blk_fc2_w = load_npy("weights/dec_blk_fc2_w.npy") as [f32; 4, 1536, 384];
let dec_blk_fc2_b = load_npy("weights/dec_blk_fc2_b.npy") as [f32; 4, 384];

let dec_ln_w = load_npy("weights/dec_ln_w.npy") as [f32; 384];
let dec_ln_b = load_npy("weights/dec_ln_b.npy") as [f32; 384];

// ====================== Encoder ======================

fn encoder_block(x: [f32; 1500, 384], L: i32) -> [f32; 1500, 384] {
    let ln1 = layer_normalization(x, enc_blk_sa_ln_w[L], enc_blk_sa_ln_b[L], 1e-5, -1);

    let Q[s in 0..1500, d in 0..384] =
        sum[k in 0..384](ln1[s, k] * enc_blk_sa_q_w[L, k, d]) + enc_blk_sa_q_b[L, d];
    let K[s in 0..1500, d in 0..384] =
        sum[k in 0..384](ln1[s, k] * enc_blk_sa_k_w[L, k, d]);
    let V[s in 0..1500, d in 0..384] =
        sum[k in 0..384](ln1[s, k] * enc_blk_sa_v_w[L, k, d]) + enc_blk_sa_v_b[L, d];

    let Qh[h in 0..6, s in 0..1500, d in 0..64] = Q[s, h * 64 + d];
    let Kh[h in 0..6, s in 0..1500, d in 0..64] = K[s, h * 64 + d];
    let Vh[h in 0..6, s in 0..1500, d in 0..64] = V[s, h * 64 + d];

    let score[h in 0..6, i in 0..1500, j in 0..1500] =
        sum[d in 0..64](Qh[h, i, d] * Kh[h, j, d]) / 8.0;
    let score_max[h in 0..6, i in 0..1500] = max[j in 0..1500](score[h, i, j]);
    let score_exp[h in 0..6, i in 0..1500, j in 0..1500] =
        exp(score[h, i, j] - score_max[h, i]);
    let score_sum[h in 0..6, i in 0..1500] = sum[j in 0..1500](score_exp[h, i, j]);
    let attn[h in 0..6, i in 0..1500, j in 0..1500] =
        score_exp[h, i, j] / score_sum[h, i];

    let ctx[h in 0..6, i in 0..1500, d in 0..64] =
        sum[j in 0..1500](attn[h, i, j] * Vh[h, j, d]);
    let cat[s in 0..1500, d in 0..384] = ctx[d / 64, s, d % 64];

    let proj[s in 0..1500, d in 0..384] =
        sum[k in 0..384](cat[s, k] * enc_blk_sa_o_w[L, k, d]) + enc_blk_sa_o_b[L, d];
    let res1[s in 0..1500, d in 0..384] = x[s, d] + proj[s, d];

    let ln2 = layer_normalization(res1, enc_blk_mlp_ln_w[L], enc_blk_mlp_ln_b[L], 1e-5, -1);

    let fc1[s in 0..1500, k in 0..1536] =
        sum[d in 0..384](ln2[s, d] * enc_blk_fc1_w[L, d, k]) + enc_blk_fc1_b[L, k];
    let act[s in 0..1500, k in 0..1536] = gelu(fc1[s, k]);
    let fc2[s in 0..1500, d in 0..384] =
        sum[k in 0..1536](act[s, k] * enc_blk_fc2_w[L, k, d]) + enc_blk_fc2_b[L, d];

    let out[s in 0..1500, d in 0..384] = res1[s, d] + fc2[s, d];
    out
}

fn encode(mel: [f32; 80, 3000]) -> [f32; 1500, 384] {
    let mel_pad[c in 0..80, t in 1..3001] = mel[c, t - 1];
    let mel_pad[c in 0..80, t in 0..1] = 0.0;
    let mel_pad[c in 0..80, t in 3001..3002] = 0.0;

    let c1[co in 0..384, t in 0..3000] =
        sum[ci in 0..80, k in 0..3](mel_pad[ci, t + k] * enc_conv1_w[co, ci, k])
        + enc_conv1_b[co];
    let c1a[co in 0..384, t in 0..3000] = gelu(c1[co, t]);

    let c1_pad[c in 0..384, t in 1..3001] = c1a[c, t - 1];
    let c1_pad[c in 0..384, t in 0..1] = 0.0;
    let c1_pad[c in 0..384, t in 3001..3002] = 0.0;

    let c2[co in 0..384, t in 0..1500] =
        sum[ci in 0..384, k in 0..3](c1_pad[ci, t * 2 + k] * enc_conv2_w[co, ci, k])
        + enc_conv2_b[co];
    let c2a[co in 0..384, t in 0..1500] = gelu(c2[co, t]);

    let enc_in[t in 0..1500, d in 0..384] = c2a[d, t] + enc_pos_emb[t, d];

    let x0 = encoder_block(enc_in, 0);
    let x1 = encoder_block(x0, 1);
    let x2 = encoder_block(x1, 2);
    let x3 = encoder_block(x2, 3);

    let out = layer_normalization(x3, enc_ln_w, enc_ln_b, 1e-5, -1);
    out
}

// ====================== Decoder ======================

fn decoder_cross_k_heads(enc: [f32; 1500, 384], L: i32) -> [f32; 6, 1500, 64] {
    let Kc[s in 0..1500, d in 0..384] =
        sum[k in 0..384](enc[s, k] * dec_blk_ca_k_w[L, k, d]);
    let Kch[h in 0..6, s in 0..1500, d in 0..64] = Kc[s, h * 64 + d];
    Kch
}

fn decoder_cross_v_heads(enc: [f32; 1500, 384], L: i32) -> [f32; 6, 1500, 64] {
    let Vc[s in 0..1500, d in 0..384] =
        sum[k in 0..384](enc[s, k] * dec_blk_ca_v_w[L, k, d]) + dec_blk_ca_v_b[L, d];
    let Vch[h in 0..6, s in 0..1500, d in 0..64] = Vc[s, h * 64 + d];
    Vch
}

fn decoder_block(x: [f32; 40, 384], Kch: [f32; 6, 1500, 64], Vch: [f32; 6, 1500, 64], L: i32) -> [f32; 40, 384] {
    let ln1 = layer_normalization(x, dec_blk_sa_ln_w[L], dec_blk_sa_ln_b[L], 1e-5, -1);

    let Q[s in 0..40, d in 0..384] =
        sum[k in 0..384](ln1[s, k] * dec_blk_sa_q_w[L, k, d]) + dec_blk_sa_q_b[L, d];
    let K[s in 0..40, d in 0..384] =
        sum[k in 0..384](ln1[s, k] * dec_blk_sa_k_w[L, k, d]);
    let V[s in 0..40, d in 0..384] =
        sum[k in 0..384](ln1[s, k] * dec_blk_sa_v_w[L, k, d]) + dec_blk_sa_v_b[L, d];

    let Qh[h in 0..6, s in 0..40, d in 0..64] = Q[s, h * 64 + d];
    let Kh[h in 0..6, s in 0..40, d in 0..64] = K[s, h * 64 + d];
    let Vh[h in 0..6, s in 0..40, d in 0..64] = V[s, h * 64 + d];

    let score[h in 0..6, i in 0..40, j in 0..40] =
        sum[d in 0..64](Qh[h, i, d] * Kh[h, j, d]) / 8.0
        + if j <= i { 0.0 } else { -10000.0 };
    let score_max[h in 0..6, i in 0..40] = max[j in 0..40](score[h, i, j]);
    let score_exp[h in 0..6, i in 0..40, j in 0..40] =
        exp(score[h, i, j] - score_max[h, i]);
    let score_sum[h in 0..6, i in 0..40] = sum[j in 0..40](score_exp[h, i, j]);
    let sa[h in 0..6, i in 0..40, j in 0..40] =
        score_exp[h, i, j] / score_sum[h, i];

    let sa_ctx[h in 0..6, i in 0..40, d in 0..64] =
        sum[j in 0..40](sa[h, i, j] * Vh[h, j, d]);
    let sa_cat[s in 0..40, d in 0..384] = sa_ctx[d / 64, s, d % 64];

    let sa_proj[s in 0..40, d in 0..384] =
        sum[k in 0..384](sa_cat[s, k] * dec_blk_sa_o_w[L, k, d]) + dec_blk_sa_o_b[L, d];
    let res1[s in 0..40, d in 0..384] = x[s, d] + sa_proj[s, d];

    let ln2 = layer_normalization(res1, dec_blk_ca_ln_w[L], dec_blk_ca_ln_b[L], 1e-5, -1);

    let Qc[s in 0..40, d in 0..384] =
        sum[k in 0..384](ln2[s, k] * dec_blk_ca_q_w[L, k, d]) + dec_blk_ca_q_b[L, d];

    let Qch[h in 0..6, s in 0..40, d in 0..64] = Qc[s, h * 64 + d];

    let cscore[h in 0..6, i in 0..40, j in 0..1500] =
        sum[d in 0..64](Qch[h, i, d] * Kch[h, j, d]) / 8.0;
    let cscore_max[h in 0..6, i in 0..40] = max[j in 0..1500](cscore[h, i, j]);
    let cscore_exp[h in 0..6, i in 0..40, j in 0..1500] =
        exp(cscore[h, i, j] - cscore_max[h, i]);
    let cscore_sum[h in 0..6, i in 0..40] = sum[j in 0..1500](cscore_exp[h, i, j]);
    let ca[h in 0..6, i in 0..40, j in 0..1500] =
        cscore_exp[h, i, j] / cscore_sum[h, i];

    let ca_ctx[h in 0..6, i in 0..40, d in 0..64] =
        sum[j in 0..1500](ca[h, i, j] * Vch[h, j, d]);
    let ca_cat[s in 0..40, d in 0..384] = ca_ctx[d / 64, s, d % 64];

    let ca_proj[s in 0..40, d in 0..384] =
        sum[k in 0..384](ca_cat[s, k] * dec_blk_ca_o_w[L, k, d]) + dec_blk_ca_o_b[L, d];
    let res2[s in 0..40, d in 0..384] = res1[s, d] + ca_proj[s, d];

    let ln3 = layer_normalization(res2, dec_blk_mlp_ln_w[L], dec_blk_mlp_ln_b[L], 1e-5, -1);

    let fc1[s in 0..40, k in 0..1536] =
        sum[d in 0..384](ln3[s, d] * dec_blk_fc1_w[L, d, k]) + dec_blk_fc1_b[L, k];
    let act[s in 0..40, k in 0..1536] = gelu(fc1[s, k]);
    let fc2[s in 0..40, d in 0..384] =
        sum[k in 0..1536](act[s, k] * dec_blk_fc2_w[L, k, d]) + dec_blk_fc2_b[L, d];

    let out[s in 0..40, d in 0..384] = res2[s, d] + fc2[s, d];
    out
}

fn layer_norm_token(x: [f32; 384], scale: [f32; 384], B: [f32; 384], epsilon: f32) -> [f32; 384] {
    let mean = sum[j in 0..384](x[j]) / 384.0;
    let variance = sum[j in 0..384]((x[j] - mean) ** 2.0) / 384.0;
    let std = sqrt(variance + epsilon);
    let out[j in 0..384] = scale[j] * (x[j] - mean) / std + B[j];
    out
}

fn decoder_input_token(token_id: i32, pos: i32) -> [f32; 384] {
    let out[d in 0..384] = dec_tok_emb[token_id, d] + dec_pos_emb[pos, d];
    out
}

fn decoder_zero_step() -> ([f32; 384], [f32; 6, 40, 64], [f32; 6, 40, 64]) {
    let token[d in 0..384] = 0.0;
    let K[h in 0..6, p in 0..40, d in 0..64] = 0.0;
    let V[h in 0..6, p in 0..40, d in 0..64] = 0.0;
    (token, K, V)
}

fn decoder_self_attn_token(
    x_token: [f32; 384],
    K_prev: [f32; 6, 40, 64],
    V_prev: [f32; 6, 40, 64],
    step: i32,
    L: i32
) -> ([f32; 384], [f32; 6, 40, 64], [f32; 6, 40, 64]) {
    let ln1 = layer_norm_token(x_token, dec_blk_sa_ln_w[L], dec_blk_sa_ln_b[L], 1e-5);

    let Q[d in 0..384] =
        sum[k in 0..384](ln1[k] * dec_blk_sa_q_w[L, k, d]) + dec_blk_sa_q_b[L, d];
    let K_new[d in 0..384] =
        sum[k in 0..384](ln1[k] * dec_blk_sa_k_w[L, k, d]);
    let V_new[d in 0..384] =
        sum[k in 0..384](ln1[k] * dec_blk_sa_v_w[L, k, d]) + dec_blk_sa_v_b[L, d];

    let Qh[h in 0..6, d in 0..64] = Q[h * 64 + d];
    let Kh_new[h in 0..6, d in 0..64] = K_new[h * 64 + d];
    let Vh_new[h in 0..6, d in 0..64] = V_new[h * 64 + d];

    let K_next[h in 0..6, p in 0..40, d in 0..64] =
        if p == step - 1 { Kh_new[h, d] } else { K_prev[h, p, d] };
    let V_next[h in 0..6, p in 0..40, d in 0..64] =
        if p == step - 1 { Vh_new[h, d] } else { V_prev[h, p, d] };

    let score[h in 0..6, p in 0..step] =
        sum[d in 0..64](Qh[h, d] * K_next[h, p, d]) / 8.0;
    let score_max[h in 0..6] = max[p in 0..step](score[h, p]);
    let score_exp[h in 0..6, p in 0..step] = exp(score[h, p] - score_max[h]);
    let score_sum[h in 0..6] = sum[p in 0..step](score_exp[h, p]);
    let attn[h in 0..6, p in 0..step] = score_exp[h, p] / score_sum[h];

    let sa_ctx[h in 0..6, d in 0..64] =
        sum[p in 0..step](attn[h, p] * V_next[h, p, d]);
    let sa_cat[d in 0..384] = sa_ctx[d / 64, d % 64];

    let sa_proj[d in 0..384] =
        sum[k in 0..384](sa_cat[k] * dec_blk_sa_o_w[L, k, d]) + dec_blk_sa_o_b[L, d];
    let res1[d in 0..384] = x_token[d] + sa_proj[d];
    (res1, K_next, V_next)
}

fn decoder_cross_attn_token(
    x_token: [f32; 384],
    Kch: [f32; 6, 1500, 64],
    Vch: [f32; 6, 1500, 64],
    L: i32
) -> [f32; 384] {
    let ln2 = layer_norm_token(x_token, dec_blk_ca_ln_w[L], dec_blk_ca_ln_b[L], 1e-5);

    let Qc[d in 0..384] =
        sum[k in 0..384](ln2[k] * dec_blk_ca_q_w[L, k, d]) + dec_blk_ca_q_b[L, d];
    let Qch[h in 0..6, d in 0..64] = Qc[h * 64 + d];

    let cscore[h in 0..6, j in 0..1500] =
        sum[d in 0..64](Qch[h, d] * Kch[h, j, d]) / 8.0;
    let cscore_max[h in 0..6] = max[j in 0..1500](cscore[h, j]);
    let cscore_exp[h in 0..6, j in 0..1500] = exp(cscore[h, j] - cscore_max[h]);
    let cscore_sum[h in 0..6] = sum[j in 0..1500](cscore_exp[h, j]);
    let ca[h in 0..6, j in 0..1500] = cscore_exp[h, j] / cscore_sum[h];

    let ca_ctx[h in 0..6, d in 0..64] =
        sum[j in 0..1500](ca[h, j] * Vch[h, j, d]);
    let ca_cat[d in 0..384] = ca_ctx[d / 64, d % 64];

    let ca_proj[d in 0..384] =
        sum[k in 0..384](ca_cat[k] * dec_blk_ca_o_w[L, k, d]) + dec_blk_ca_o_b[L, d];
    let res2[d in 0..384] = x_token[d] + ca_proj[d];
    res2
}

fn decoder_mlp_token(x_token: [f32; 384], L: i32) -> [f32; 384] {
    let ln3 = layer_norm_token(x_token, dec_blk_mlp_ln_w[L], dec_blk_mlp_ln_b[L], 1e-5);

    let fc1[k in 0..1536] =
        sum[d in 0..384](ln3[d] * dec_blk_fc1_w[L, d, k]) + dec_blk_fc1_b[L, k];
    let act[k in 0..1536] = gelu(fc1[k]);
    let fc2[d in 0..384] =
        sum[k in 0..1536](act[k] * dec_blk_fc2_w[L, k, d]) + dec_blk_fc2_b[L, d];

    let out[d in 0..384] = x_token[d] + fc2[d];
    out
}

fn decoder_block_token(
    x_token: [f32; 384],
    K_prev: [f32; 6, 40, 64],
    V_prev: [f32; 6, 40, 64],
    Kch: [f32; 6, 1500, 64],
    Vch: [f32; 6, 1500, 64],
    step: i32,
    L: i32
) -> ([f32; 384], [f32; 6, 40, 64], [f32; 6, 40, 64]) {
    let (res1, K_next, V_next) = decoder_self_attn_token(x_token, K_prev, V_prev, step, L);
    let res2 = decoder_cross_attn_token(res1, Kch, Vch, L);
    let out = decoder_mlp_token(res2, L);
    (out, K_next, V_next)
}

fn make_cross_cache(
    Kch0: [f32; 6, 1500, 64],
    Vch0: [f32; 6, 1500, 64],
    Kch1: [f32; 6, 1500, 64],
    Vch1: [f32; 6, 1500, 64],
    Kch2: [f32; 6, 1500, 64],
    Vch2: [f32; 6, 1500, 64],
    Kch3: [f32; 6, 1500, 64],
    Vch3: [f32; 6, 1500, 64]
) -> (
    [f32; 6, 1500, 64],
    [f32; 6, 1500, 64],
    [f32; 6, 1500, 64],
    [f32; 6, 1500, 64],
    [f32; 6, 1500, 64],
    [f32; 6, 1500, 64],
    [f32; 6, 1500, 64],
    [f32; 6, 1500, 64]
) {
    (Kch0, Vch0, Kch1, Vch1, Kch2, Vch2, Kch3, Vch3)
}

fn make_prev_cache(
    K0: [f32; 6, 40, 64],
    V0: [f32; 6, 40, 64],
    K1: [f32; 6, 40, 64],
    V1: [f32; 6, 40, 64],
    K2: [f32; 6, 40, 64],
    V2: [f32; 6, 40, 64],
    K3: [f32; 6, 40, 64],
    V3: [f32; 6, 40, 64]
) -> (
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64]
) {
    (K0, V0, K1, V1, K2, V2, K3, V3)
}

fn whisper_decode_step(
    current_token_id: i32,
    step: i32,
    cross_cache: (
        [f32; 6, 1500, 64],
        [f32; 6, 1500, 64],
        [f32; 6, 1500, 64],
        [f32; 6, 1500, 64],
        [f32; 6, 1500, 64],
        [f32; 6, 1500, 64],
        [f32; 6, 1500, 64],
        [f32; 6, 1500, 64]
    ),
    prev_cache: (
        [f32; 6, 40, 64],
        [f32; 6, 40, 64],
        [f32; 6, 40, 64],
        [f32; 6, 40, 64],
        [f32; 6, 40, 64],
        [f32; 6, 40, 64],
        [f32; 6, 40, 64],
        [f32; 6, 40, 64]
    )
) -> (
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    [f32; 6, 40, 64],
    i32
) {
    let x = decoder_input_token(current_token_id, step - 1);
    let (x0, K0_next, V0_next) = decoder_block_token(x, prev_cache.0, prev_cache.1, cross_cache.0, cross_cache.1, step, 0);
    let (x1, K1_next, V1_next) = decoder_block_token(x0, prev_cache.2, prev_cache.3, cross_cache.2, cross_cache.3, step, 1);
    let (x2, K2_next, V2_next) = decoder_block_token(x1, prev_cache.4, prev_cache.5, cross_cache.4, cross_cache.5, step, 2);
    let (x3, K3_next, V3_next) = decoder_block_token(x2, prev_cache.6, prev_cache.7, cross_cache.6, cross_cache.7, step, 3);
    let final_ln = layer_norm_token(x3, dec_ln_w, dec_ln_b, 1e-5);
    let logits[v in 0..51865] = sum[d in 0..384](final_ln[d] * dec_tok_emb[v, d]);
    let next_token = argmax[v](logits[v]);
    (K0_next, V0_next, K1_next, V1_next, K2_next, V2_next, K3_next, V3_next, next_token)
}

// ====================== Autoregressive decode ======================

let mel = load_npy("samples/jfk.npy") as [f32; 80, 3000];
let enc_out = encode(mel);
let dec_kch0 = decoder_cross_k_heads(enc_out, 0);
let dec_vch0 = decoder_cross_v_heads(enc_out, 0);
let dec_kch1 = decoder_cross_k_heads(enc_out, 1);
let dec_vch1 = decoder_cross_v_heads(enc_out, 1);
let dec_kch2 = decoder_cross_k_heads(enc_out, 2);
let dec_vch2 = decoder_cross_v_heads(enc_out, 2);
let dec_kch3 = decoder_cross_k_heads(enc_out, 3);
let dec_vch3 = decoder_cross_v_heads(enc_out, 3);
let cross_cache = make_cross_cache(dec_kch0, dec_vch0, dec_kch1, dec_vch1, dec_kch2, dec_vch2, dec_kch3, dec_vch3);

let SOT_TOKENS = [50258, 50259, 50359, 50363];
let zero_step = decoder_zero_step();
let K_zero = zero_step.1;
let V_zero = zero_step.2;
let zero_cache = make_prev_cache(K_zero, V_zero, K_zero, V_zero, K_zero, V_zero, K_zero, V_zero);

let warm1 = whisper_decode_step(
    SOT_TOKENS[0], 1,
    cross_cache,
    zero_cache
);
let warm2 = whisper_decode_step(
    SOT_TOKENS[1], 2,
    cross_cache,
    make_prev_cache(warm1.0, warm1.1, warm1.2, warm1.3, warm1.4, warm1.5, warm1.6, warm1.7)
);
let warm3 = whisper_decode_step(
    SOT_TOKENS[2], 3,
    cross_cache,
    make_prev_cache(warm2.0, warm2.1, warm2.2, warm2.3, warm2.4, warm2.5, warm2.6, warm2.7)
);
let warm4 = whisper_decode_step(
    SOT_TOKENS[3], 4,
    cross_cache,
    make_prev_cache(warm3.0, warm3.1, warm3.2, warm3.3, warm3.4, warm3.5, warm3.6, warm3.7)
);
let decode_state[0] = warm4;
let decode_state[s in 1..36] = whisper_decode_step(
    decode_state[s - 1].8, s + 4,
    cross_cache,
    make_prev_cache(
        decode_state[s - 1].0, decode_state[s - 1].1,
        decode_state[s - 1].2, decode_state[s - 1].3,
        decode_state[s - 1].4, decode_state[s - 1].5,
        decode_state[s - 1].6, decode_state[s - 1].7
    )
);
let tokens[t in 0..40] = if t < 4 { SOT_TOKENS[t] } else { decode_state[t - 4].8 };

let text = python::whisper_helpers::decode_tokens(tokens);
print(text);
