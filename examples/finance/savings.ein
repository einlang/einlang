// Savings / compound interest: b[t] = b[t-1]*(1+r) + deposit. Finance projections (Julia: same style as [QuantEcon](https://julia.quantecon.org/), [JuliaHub Betterment](https://juliahub.com/case-studies/betterment))
//
// Julia equivalent (1-based; same order as below):
//   initial = 1000.0
//   r = 0.05 / 12.0
//   deposit = 100.0
//   b = zeros(61)
//   b[1] = initial
//   for t in 2:61
//       b[t] = b[t-1] * (1.0 + r) + deposit
//   end

let initial = 1000.0;
let r = 0.05 / 12.0;
let deposit = 100.0;

let b[0] = initial;
let b[t in 1..61] = b[t - 1] * (1.0 + r) + deposit;

// Small autodiff sensitivity check: how one month's balance moves with r and deposit.
// This does not change the core savings trajectory above.
let month1_balance = initial * (1.0 + r) + deposit;
let d_month1_balance_d_r = @month1_balance / @r;
let d_month1_balance_d_deposit = @month1_balance / @deposit;

print(b);
print("Autodiff sensitivities for month 1 balance: d(balance)/dr, d(balance)/d(deposit)");
print([d_month1_balance_d_r, d_month1_balance_d_deposit]);
