// Tiny repro: same logits clause, but using a plain slice outside recurrence.
//
// Run:
//   PYTHONPATH=../../src python3 -m einlang repro_vectorize_logits_slice_only.ein --debug-vectorize-detail --profile-reductions

let x[n in 0..2, k in 0..4] = (1 + n + k) as f32;

let theta_full[t in 0..2, p in 0..5, j in 0..3] =
    if p == 4 { 0.5 * (1 + j) as f32 } else { 0.1 * (1 + t + p + j) as f32 };
let prev_theta = theta_full[0] as [f32; 5, 3];

let logits[n in 0..2, j in 0..3] =
    sum[k in 0..4](x[n, k] * prev_theta[k, j]) + prev_theta[4, j];
let diff[n in 0..2, j in 0..3] = logits[n, j] - (n == j) as f32;
let loss = sum[n in 0..2, j in 0..3](diff[n, j] * diff[n, j]);

print(logits);
print(loss);
