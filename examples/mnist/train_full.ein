// Native-autodiff training on the bundled real 28x28 MNIST sample images.
// Uses the same 10 real sample images in examples/mnist/samples for both
// training and evaluation, with explicitly unrolled epochs.
// This remains the default because it must not be slower than the recurrence version.
// Run (cwd = examples/mnist): PYTHONPATH=../../src python3 -m einlang train_full.ein

let sample_images = python::data_loader::load_images() as [f32; 10, 784];
let sample_labels = python::data_loader::load_labels() as [f32; 10, 10];

let lr = 5e-2;
let truth[n] = argmax[cls](sample_labels[n, cls]);

let theta0[p in 0..785, cls in 0..10] =
    if p == 784 { 0.0 } else { 1e-3 * (1.0 + ((p % 17) + cls) as f32) };

let logits0[n in 0..10, cls in 0..10] =
    sum[d in 0..784](sample_images[n, d] * theta0[d, cls]) + theta0[784, cls];
let diff0[n in 0..10, cls in 0..10] =
    logits0[n, cls] - sample_labels[n, cls];
let loss0 =
    sum[n in 0..10, cls in 0..10](diff0[n, cls] * diff0[n, cls]) / 100.0;
let preds0[n] = argmax[cls](logits0[n, cls]);
let correct0 = sum[n in 0..10](if preds0[n] == truth[n] { 1 } else { 0 });
let accuracy0 = (correct0 as f32) / 10.0;
print("Epoch 0:", "loss", loss0, "accuracy", accuracy0 * 100.0, "%", "correct", correct0);

let d_theta0 = @loss0 / @theta0;
let theta1[p in 0..785, cls in 0..10] =
    theta0[p, cls] - lr * d_theta0[p, cls];

let logits1[n in 0..10, cls in 0..10] =
    sum[d in 0..784](sample_images[n, d] * theta1[d, cls]) + theta1[784, cls];
let diff1[n in 0..10, cls in 0..10] =
    logits1[n, cls] - sample_labels[n, cls];
let loss1 =
    sum[n in 0..10, cls in 0..10](diff1[n, cls] * diff1[n, cls]) / 100.0;
let preds1[n] = argmax[cls](logits1[n, cls]);
let correct1 = sum[n in 0..10](if preds1[n] == truth[n] { 1 } else { 0 });
let accuracy1 = (correct1 as f32) / 10.0;
print("Epoch 1:", "loss", loss1, "accuracy", accuracy1 * 100.0, "%", "correct", correct1);

let d_theta1 = @loss1 / @theta1;
let theta2[p in 0..785, cls in 0..10] =
    theta1[p, cls] - lr * d_theta1[p, cls];

let logits2[n in 0..10, cls in 0..10] =
    sum[d in 0..784](sample_images[n, d] * theta2[d, cls]) + theta2[784, cls];
let diff2[n in 0..10, cls in 0..10] =
    logits2[n, cls] - sample_labels[n, cls];
let loss2 =
    sum[n in 0..10, cls in 0..10](diff2[n, cls] * diff2[n, cls]) / 100.0;
let preds2[n] = argmax[cls](logits2[n, cls]);
let correct2 = sum[n in 0..10](if preds2[n] == truth[n] { 1 } else { 0 });
let accuracy2 = (correct2 as f32) / 10.0;
print("Epoch 2:", "loss", loss2, "accuracy", accuracy2 * 100.0, "%", "correct", correct2);

let d_theta2 = @loss2 / @theta2;
let theta3[p in 0..785, cls in 0..10] =
    theta2[p, cls] - lr * d_theta2[p, cls];

let logits3[n in 0..10, cls in 0..10] =
    sum[d in 0..784](sample_images[n, d] * theta3[d, cls]) + theta3[784, cls];
let diff3[n in 0..10, cls in 0..10] =
    logits3[n, cls] - sample_labels[n, cls];
let loss3 =
    sum[n in 0..10, cls in 0..10](diff3[n, cls] * diff3[n, cls]) / 100.0;
let preds3[n] = argmax[cls](logits3[n, cls]);
let correct3 = sum[n in 0..10](if preds3[n] == truth[n] { 1 } else { 0 });
let accuracy3 = (correct3 as f32) / 10.0;
print("Epoch 3:", "loss", loss3, "accuracy", accuracy3 * 100.0, "%", "correct", correct3);

let d_theta3 = @loss3 / @theta3;
let theta4[p in 0..785, cls in 0..10] =
    theta3[p, cls] - lr * d_theta3[p, cls];

let logits4[n in 0..10, cls in 0..10] =
    sum[d in 0..784](sample_images[n, d] * theta4[d, cls]) + theta4[784, cls];
let diff4[n in 0..10, cls in 0..10] =
    logits4[n, cls] - sample_labels[n, cls];
let loss4 =
    sum[n in 0..10, cls in 0..10](diff4[n, cls] * diff4[n, cls]) / 100.0;
let preds4[n] = argmax[cls](logits4[n, cls]);
let correct4 = sum[n in 0..10](if preds4[n] == truth[n] { 1 } else { 0 });
let accuracy4 = (correct4 as f32) / 10.0;
print("Epoch 4:", "loss", loss4, "accuracy", accuracy4 * 100.0, "%", "correct", correct4);

let d_theta4 = @loss4 / @theta4;
let theta5[p in 0..785, cls in 0..10] =
    theta4[p, cls] - lr * d_theta4[p, cls];

let logits5[n in 0..10, cls in 0..10] =
    sum[d in 0..784](sample_images[n, d] * theta5[d, cls]) + theta5[784, cls];
let diff5[n in 0..10, cls in 0..10] =
    logits5[n, cls] - sample_labels[n, cls];
let loss5 =
    sum[n in 0..10, cls in 0..10](diff5[n, cls] * diff5[n, cls]) / 100.0;
let preds5[n] = argmax[cls](logits5[n, cls]);
let correct5 = sum[n in 0..10](if preds5[n] == truth[n] { 1 } else { 0 });
let accuracy5 = (correct5 as f32) / 10.0;
print("Epoch 5:", "loss", loss5, "accuracy", accuracy5 * 100.0, "%", "correct", correct5);

assert(loss1 < loss0, "epoch 1 did not decrease loss");
assert(loss2 < loss1, "epoch 2 did not decrease loss");
assert(loss3 < loss2, "epoch 3 did not decrease loss");
assert(loss4 < loss3, "epoch 4 did not decrease loss");
assert(loss5 < loss4, "epoch 5 did not decrease loss");

print("Epoch 0 loss:", loss0);
print("Epoch 1 loss:", loss1);
print("Epoch 2 loss:", loss2);
print("Epoch 3 loss:", loss3);
print("Epoch 4 loss:", loss4);
print("Epoch 5 loss:", loss5);
print("Epoch 0 train/test accuracy:", accuracy0 * 100.0, "%");
print("Epoch 1 train/test accuracy:", accuracy1 * 100.0, "%");
print("Epoch 2 train/test accuracy:", accuracy2 * 100.0, "%");
print("Epoch 3 train/test accuracy:", accuracy3 * 100.0, "%");
print("Epoch 4 train/test accuracy:", accuracy4 * 100.0, "%");
print("Epoch 5 train/test accuracy:", accuracy5 * 100.0, "%");
print("Correct predictions after epoch 5:", correct5);
