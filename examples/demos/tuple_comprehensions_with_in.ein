// Tuple Comprehensions with 'in' Operator in Einlang.
// Keeps the same coverage while staying quiet during tests.

let basic_pairs = [(i, j) | i in 1..4, j in 5..8];
assert(len(basic_pairs) == 9, "pair comprehensions should enumerate every combination");

let letters = [10, 20, 30];
let mixed_pairs = [(num, arr_val) | num in 1..4, arr_val in letters];
assert(len(mixed_pairs) == 9, "mixing ranges and arrays should still produce a flat product");

let even_sum_pairs = [(i, j) | i in 1..5, j in 1..5, (i + j) % 2 == 0];
assert(len(even_sum_pairs) == 8, "filtered pairs should keep only even-sum combinations");

let ordered_pairs = [(i, j) | i in 1..6, j in 1..6, i < j];
assert(len(ordered_pairs) == 10, "ordered pair filter should keep upper-triangular pairs");

let excluded = [2, 4];
let filtered_pairs = [(i, j) | i in 1..5, j in 6..9, !(i in excluded)];
assert(len(filtered_pairs) == 6, "membership filters should trim tuple comprehensions");

let triples = [(i, j, k) | i in 1..3, j in 4..6, k in 7..9];
assert(len(triples) == 8, "triple comprehensions should form a full Cartesian product");

let small_triples = [(a, b, c) | a in 1..4, b in 1..4, c in 1..4, a + b > c];
assert(len(small_triples) > 0, "filtered triple comprehensions should still produce results");

let grid_coords = [(row, col) | row in 0..3, col in 0..3];
assert(len(grid_coords) == 9, "3x3 grid coordinates should stay flat");

let valid_moves = [(x, y) | x in 0..8, y in 0..8, x + y <= 5];
assert(len(valid_moves) == 21, "filtered grid coordinates should keep the valid region");

let set_a = [1, 2, 3, 4];
let set_b = [3, 4, 5, 6];
let intersection_pairs = [(i, j) | i in set_a, j in set_b, i == j];
assert(intersection_pairs == [(3, 3), (4, 4)], "tuple comprehensions should express set intersections");

let colors = [1, 2];  // Representing Red=1, Blue=2;
let sizes = [10, 20]; // Representing Small=10, Large=20;
let product_combinations = [(color, size) | color in colors, size in sizes];
assert(len(product_combinations) == 4, "cross products should remain simple to count");

let upper_triangular = [(i, j) | i in 0..4, j in 0..4, i <= j];
assert(len(upper_triangular) == 10, "upper-triangular index generation should work");

let near_diagonal = [(i, j) | i in 0..4, j in 0..4, (i - j) * (i - j) <= 1];
assert(len(near_diagonal) == 10, "near-diagonal filtering should keep adjacent coordinates");
