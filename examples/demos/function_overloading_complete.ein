// Complete Function Overloading Demo
// Shows mathematical function overloading working through actual Einlang imports.

use std::math::abs;
use std::math::sqrt;
use std::math::sin;
use std::math::cos;
use std::math::pow;

let x = -5.0;
let y = 16.0;
let angle = 0.0;
assert(abs(x) == 5.0, "scalar abs should work");
assert(sqrt(y) == 4.0, "scalar sqrt should work");
assert(sin(angle) == 0.0, "scalar sin should work");
assert(cos(angle) == 1.0, "scalar cos should work");

let vector = [-2, -1, 0, 1, 2];
let vector_abs = abs(vector);
assert(vector_abs[0] == 2, "tensor abs should be element-wise");
assert(vector_abs[4] == 2, "tensor abs should preserve shape");

let matrix = [[1.0, 4.0], [9.0, 16.0]];
let matrix_sqrt = sqrt(matrix);
assert(matrix_sqrt[0, 0] == 1.0, "tensor sqrt should be element-wise");
assert(matrix_sqrt[1, 1] == 4.0, "tensor sqrt should preserve matrix layout");

assert(pow(3.0, 2.0) == 9.0, "overloaded imports should remain usable");
