// Test Import System
// Simple test to see what's working

// Test basic builtins
assert(typeof(42) == "i32", "type builtin should work");
assert(len([1, 2, 3]) == 3, "len builtin should work");
assert(true, "Assert works");

// Test module import
// Try importing from math module (which re-exports from basic)
use std::math::abs;

// Test usage
let x = -5.0;
assert(abs(x) == 5.0, "imported abs should work");
