// Array Structure Comparison: Why Array of Pairs is More Intuitive

let pairs = [(i, j) | i in 1..3, j in 4..6];
assert(len(pairs) == 4, "Cartesian product should produce one pair per combination");

let coords = [(x, y) | x in 0..2, y in 0..2];
assert(len(coords) == 4, "2x2 grid coordinates should remain flat");

let chess_squares = [(file, rank) | file in 0..8, rank in 0..8];
assert(len(chess_squares) == 64, "8x8 chess board should yield 64 coordinate pairs");

let rgb_samples = [(r, g, b) | r in [0, 255], g in [0, 255], b in [0, 128]];
assert(len(rgb_samples) == 8, "Cartesian products should scale predictably");

let params = [(lr, batch) | lr in [1, 10], batch in [16, 32]];
assert(len(params) == 4, "parameter grid should stay flat and count combinations directly");
