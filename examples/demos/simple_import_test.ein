// Simple Import Test
// Test just the basic import system

// Test what's available without any imports
assert(typeof(42) == "i32", "basic builtins should remain available");
assert(len([1, 2, 3]) == 3, "basic builtins should work before imports");

// Try a very simple stdlib import 
// Try importing a simple math constant function
use std::math::constants::pi;

assert(pi() > 3.14159 && pi() < 3.14160, "stdlib import should expose pi");
