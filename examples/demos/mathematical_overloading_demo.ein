// Mathematical Function Overloading Demo
// Demonstrates duck typing for mathematical functions that work on both scalars and tensors

// Import mathematical functions that support overloading (working functions only)
use std::math::abs;
use std::math::sqrt;
use std::math::pow;
use std::math::max;
use std::math::min;

// =============================================================================
// BASIC MATHEMATICAL FUNCTIONS
// =============================================================================

// Absolute value - works on scalars and tensors
let x_scalar = -5.0;
let x_vector = [-2, -1, 0, 1, 2];
let x_matrix = [[-3, -2], [-1, 0], [1, 2]];
let abs_vector = abs(x_vector);
let abs_matrix = abs(x_matrix);
assert(abs(x_scalar) == 5.0, "scalar abs should work");
assert(abs_vector == [2, 1, 0, 1, 2], "vector abs should be element-wise");
assert(abs_matrix[0, 0] == 3, "matrix abs should preserve layout");
assert(abs_matrix[2, 1] == 2, "matrix abs should preserve trailing entries");

// Square root - works on scalars and tensors
let y_scalar = 16.0;
let y_vector = [1, 4, 9, 16];
let y_matrix = [[1, 4], [9, 16]];

print("Scalar sqrt:", sqrt(y_scalar));         // Should print: 4.0
print("Vector sqrt:", sqrt(y_vector));         // Should print: [1, 2, 3, 4]
print("Matrix sqrt:", sqrt(y_matrix));         // Should print: [[1, 2], [3, 4]]

print();

// =============================================================================
// POWER FUNCTIONS
// =============================================================================

let base_scalar = 2.0;
let base_vector = [1, 2, 3, 4];
let exponent = 2.0;
let pow_vector = pow(base_vector, exponent);
assert(pow(base_scalar, exponent) == 4.0, "scalar pow should work");
assert(pow_vector == [1, 4, 9, 16], "vector pow should be element-wise");

// =============================================================================
// MIN/MAX FUNCTIONS
// =============================================================================

let values_1 = [1, 5, 3];
let values_2 = [2, 4, 4];
let pairwise_max = max(values_1, values_2);
let pairwise_min = min(values_1, values_2);
assert(pairwise_max == [2, 5, 4], "element-wise max should work");
assert(pairwise_min == [1, 4, 3], "element-wise min should work");

let scalar_a = 10.0;
let scalar_b = 5.0;
assert(max(scalar_a, scalar_b) == 10.0, "scalar max should work");
assert(min(scalar_a, scalar_b) == 5.0, "scalar min should work");

// =============================================================================
// BINARY OPERATIONS WITH BROADCASTING  
// =============================================================================

// Power function with scalar-tensor broadcasting
let base = 2.0;                               // scalar;
let exponents = [1.0, 2.0, 3.0, 4.0];        // vector
assert(pow(base, exponents) == [2, 4, 8, 16], "scalar-to-vector broadcasting should work");

let bases = [2.0, 3.0, 4.0];                 // vector  ;
let exp_scalar = 2.0;                         // scalar

assert(pow(bases, exp_scalar) == [4, 9, 16], "vector-to-scalar broadcasting should work");

// Element-wise power
let bases_2 = [2.0, 3.0, 4.0];
let exponents_2 = [1.0, 2.0, 3.0];
assert(pow(bases_2, exponents_2) == [2, 9, 64], "vector-to-vector power should stay element-wise");

// More examples with different data types
let int_a = 7;
let int_b = 3;
assert(max(int_a, int_b) == 7, "integer max should work");
assert(min(int_a, int_b) == 3, "integer min should work");

// =============================================================================
// MATHEMATICAL CONSISTENCY VERIFICATION
// =============================================================================

// Test mathematical identities
let test_val = 3.0;
let identity_test = sqrt(pow(test_val, 2));  // sqrt(x²) should equal |x| for positive x;
assert(identity_test == 3.0, "sqrt(pow(3, 2)) should equal 3");

// Test function composition
let composed_result = abs(test_val - 5.0);   // abs(3 - 5) = abs(-2) = 2;
assert(composed_result == 2.0, "function composition should remain mathematically consistent");
assert(sqrt(4.0) == 2.0, "valid scalar sqrt should still work");
