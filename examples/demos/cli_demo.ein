// CLI Demo - Simple working Einlang example
// Demonstrates basic language features without extra console output.

let x = 10;
let y = 20;
let sum = x + y;
let product = x * y;
assert(sum == 30, "basic arithmetic should work");
assert(product == 200, "basic multiplication should work");

let numbers = [1, 2, 3, 4, 5];
assert(numbers[0] == 1, "first array element should be preserved");
assert(numbers[4] == 5, "last array element should be preserved");

let squares = [i * i | i in 1..6];
let evens = [n | n in numbers, n % 2 == 0];
assert(squares == [1, 4, 9, 16, 25], "array comprehension should build squares");
assert(evens == [2, 4], "filtering should keep only even values");

let max_value = if x > y { x } else { y };
let classification = if sum > 25 { "large" } else { "small" };
assert(max_value == 20, "conditional max should choose the larger value");
assert(classification == "large", "conditional expression should classify the sum");

let total = sum[i](numbers[i]);
let maximum = max[i](numbers[i]);
assert(total == 15, "reduction should sum the array");
assert(maximum == 5, "reduction should find the maximum");
