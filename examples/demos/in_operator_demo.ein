// Demonstration of the 'in' operator in Einlang.
// Uses assertions instead of narration prints so tests stay quiet.

let x = 5;
assert(x in 1..10, "range membership should include the start and interior values");
assert(!(x in 6..10), "range membership should exclude values below the start");
assert(!(10 in 1..10), "ranges should exclude the end");
assert(1 in 1..10, "ranges should include the start");

let arr = [1, 2, 3, 4, 5];
assert(3 in arr, "array membership should find existing values");
assert(!(6 in arr), "array membership should reject missing values");
assert(7 in [1, 2, 3, 7, 9], "membership should work with literals");
assert(!(8 in [1, 2, 3, 7, 9]), "literal membership should reject missing values");

let matrix = [[1, 2], [3, 4], [5, 6]];
assert([3, 4] in matrix, "matrix membership should match rows");
assert([1, 2] in matrix, "matrix membership should match the first row");
assert(!([7, 8] in matrix), "matrix membership should reject absent rows");

let tensor_3d = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
assert([[1, 2], [3, 4]] in tensor_3d, "tensor membership should match nested tensors");
assert(!([[9, 10], [11, 12]] in tensor_3d), "tensor membership should reject absent slices");

let mixed = [1.0, 2.5, 3.0, 4.0];
assert(2.5 in mixed, "floating-point membership should work");
assert(4.0 in mixed, "floating-point membership should find exact matches");
assert(1 in mixed, "numeric membership should accept equivalent integer literals");
assert(!(1.5 in mixed), "floating-point membership should reject missing values");

let empty = [];
assert(!(1 in empty), "empty arrays should have no members");

let single = [42];
assert(42 in single, "single-element arrays should match their only value");
assert(!(43 in single), "single-element arrays should reject other values");
