// Tiny train: 32 samples × 16 features, 2-class linear model (synthetic, linearly separable on x[:,0]).
// Autodiff: `d_logits_dW = @logits_v / @W_init`; recurrence uses `g = @loss_b / @w_ij`.
// Run (cwd = this dir): PYTHONPATH=../../src python3 -m einlang main.ein
// All runtime debug logs: add --debug-all (no IR dumps; use --profile-all for final IR file)

use std::array::argmax;

fn load_features() -> [f32; *] { python::data_loader::load_features() }
fn load_labels() -> [f32; *] { python::data_loader::load_labels() }
fn load_weights() -> [f32; *] { python::data_loader::init_weights() }

let X = load_features() as [f32; 32, 16];
let Y = load_labels() as [f32; 32, 2];
let lr = 0.05;

let W_init = load_weights() as [f32; 16, 2];
let logits_v[j in 0..2] = sum[i in 0..16](X[0, i] * W_init[i, j]);
let d_logits_dW = @logits_v / @W_init;

let W[0, i in 0..16, j in 0..2] = 0.0;
let W[step in 1..81, i in 0..16, j in 0..2] = {
    let n = (step - 1) % 32;
    let logit_j = sum[a in 0..16](X[n, a] * W[step - 1, a, j]);
    let loss_b = (logit_j - Y[n, j]) ** 2.0;
    let w_ij = W[step - 1, i, j];
    let g = @loss_b / @w_ij;
    w_ij - lr * g
};

let final_logits[n in 0..32, j in 0..2] = sum[i in 0..16](X[n, i] * W[80, i, j]);
let predictions = [argmax(final_logits[n]) | n in 0..32];

print(predictions);
assert(len(predictions) == 32, "tiny_train: predictions length");
